<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Night variant of the base theme. Material 3 DayNight handles most
         surface colors automatically; here we only override the legacy custom
         attributes that are defined per-theme. -->
    <style name="Theme.ZerotierFix" parent="Theme.Material3.DayNight">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="colorPrimary">@color/zerotier_orange</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/zerotier_orange_container</item>
        <item name="colorOnPrimaryContainer">@color/zerotier_orange_on_container</item>
        <item name="colorSecondary">@color/teal_200</item>
        <item name="colorOnSecondary">@color/black</item>
        <item name="colorSecondaryContainer">@color/teal_200</item>
        <item name="colorOnSecondaryContainer">@color/black</item>
        <item name="android:statusBarColor" tools:targetApi="l">?attr/colorPrimary</item>
        <item name="android:navigationBarColor" tools:targetApi="l">?attr/colorSurface</item>
        <item name="greyText">@color/grey_text_night</item>
        <item name="lightGreyText">@color/light_grey_text_night</item>
        <item name="tableRowGrey">@color/table_row_grey_night</item>
    </style>
</resources>
