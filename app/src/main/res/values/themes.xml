<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. Material 3 with DayNight support.
         Dynamic (Monet) color is applied at runtime in ZerotierFixApplication. -->
    <style name="Theme.ZerotierFix" parent="Theme.Material3.DayNight">
        <!-- 使用自定义 MaterialToolbar 作为 ActionBar（见 activity_fragment.xml） -->
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <!-- Brand color (overridden by dynamic color on Android 12+). -->
        <item name="colorPrimary">@color/zerotier_orange</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/zerotier_orange_container</item>
        <item name="colorOnPrimaryContainer">@color/zerotier_orange_on_container</item>
        <item name="colorSecondary">@color/teal_200</item>
        <item name="colorOnSecondary">@color/black</item>
        <item name="colorSecondaryContainer">@color/teal_200</item>
        <item name="colorOnSecondaryContainer">@color/black</item>
        <!-- Status / navigation bar. -->
        <item name="android:statusBarColor" tools:targetApi="l">?attr/colorPrimary</item>
        <item name="android:navigationBarColor" tools:targetApi="l">?attr/colorSurface</item>
        <!-- Custom theme attributes used by legacy layouts. -->
        <item name="greyText">@color/grey_text</item>
        <item name="lightGreyText">@color/light_grey_text</item>
        <item name="tableRowGrey">@color/table_row_grey</item>
    </style>

    <style name="Theme.ZerotierFix.NoActionBar" parent="Theme.Material3.DayNight.NoActionBar" />

    <style name="Theme.ZerotierFix.AppBarOverlay" parent="ThemeOverlay.Material3.Dark.ActionBar" />

    <style name="Theme.ZerotierFix.PopupOverlay" parent="ThemeOverlay.Material3.Light" />
</resources>
