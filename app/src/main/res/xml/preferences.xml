<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android">
    <PreferenceCategory android:title="@string/planet_settings">
        <SwitchPreference
            android:defaultValue="false"
            android:key="planet_use_custom"
            android:summary="@string/planet_use_custom_summary"
            android:title="@string/use_custom_planet" />
        <Preference
            android:key="set_planet_file"
            android:title="@string/set_planet_file" />
        <Preference
            android:key="scan_planet_qr_code"
            android:title="@string/scan_planet_qr_code"
            android:summary="@string/scan_planet_qr_code_summary" />
    </PreferenceCategory>
    <PreferenceCategory android:title="@string/preferences_network">
        <CheckBoxPreference
            android:defaultValue="false"
            android:key="network_disable_ipv6"
            android:summary="@string/preferences_network_disable_ipv6_summary"
            android:title="@string/preferences_network_disable_ipv6" />
        <SwitchPreference
            android:defaultValue="false"
            android:key="network_disable_connectivity_check"
            android:summary="@string/preferences_network_disable_connectivity_check_summary"
            android:title="@string/preferences_network_disable_connectivity_check" />
    </PreferenceCategory>
</PreferenceScreen>
