<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- 扫码加入网络所需相机权限 -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <application
        android:name="net.kaaass.zerotierfix.ZerotierFixApplication"
        android:allowBackup="true"
        android:appComponentFactory="androidx.core.app.CoreComponentFactory"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.ZerotierFix"
        android:usesCleartextTraffic="true">
        <service
            android:name=".service.ZeroTierOneService"
            android:enabled="true"
            android:exported="false"
            android:permission="android.permission.BIND_VPN_SERVICE">
            <intent-filter>
                <action android:name="android.net.VpnService" />
            </intent-filter>
        </service>

        <activity
            android:name=".ui.NetworkListActivity"
            android:label="@string/app_name"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- 自定义深链：zerotier://join?n=<id> 等 -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data android:scheme="zerotier" />
            </intent-filter>
            <!-- 官方邀请链接深链（非验证型 App Link，无需 assetlinks.json） -->
            <intent-filter android:autoVerify="false">
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data
                    android:scheme="https"
                    android:host="join.zerotier.com" />
            </intent-filter>
            <intent-filter android:autoVerify="false">
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data
                    android:scheme="https"
                    android:host="my.zerotier.com" />
            </intent-filter>
            <!-- 官网 1.16.0 同款 App Link 域名（非验证型，autoVerify=false，因 joinzt.com 不归本 fork 所有） -->
            <intent-filter android:autoVerify="false">
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data
                    android:scheme="https"
                    android:host="joinzt.com"
                    android:pathPrefix="/addnetwork" />
            </intent-filter>
            <intent-filter android:autoVerify="false">
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data
                    android:scheme="https"
                    android:host="joinzt.com"
                    android:pathPrefix="/addplanet" />
            </intent-filter>
        </activity>
        <activity
            android:name=".ui.JoinNetworkActivity"
            android:label="@string/join_network" />
        <!-- 自定义扫码 Activity：强制竖屏，覆盖 journeyapps 库默认的 sensorLandscape -->
        <activity
            android:name=".ui.CaptureActivity"
            android:screenOrientation="portrait"
            android:exported="false" />
        <!-- 双保险：即便 journeyapps 库默认的 CaptureActivity 被启动，也强制竖屏 -->
        <activity
            android:name="com.journeyapps.barcodescanner.CaptureActivity"
            android:screenOrientation="portrait"
            tools:replace="android:screenOrientation" />
        <activity
            android:name=".ui.PrefsActivity"
            android:label="@string/app_name" />
        <activity
            android:name=".ui.view.NetworkDetailActivity"
            android:label="@string/network_detail" />
        <activity
            android:name=".ui.MoonOrbitActivity"
            android:label="@string/moon_orbit_activity" />
        <activity
            android:name=".ui.PeerListActivity"
            android:label="@string/peer_list" />

        <receiver
            android:name=".service.StartupReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
    </application>

</manifest>